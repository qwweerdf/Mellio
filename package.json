{
  "name": "mellio",
  "version": "0.1.0",
  "private": true,
  "description": "Your AI crew, your way. 本地优先的多 Bot AI 工作空间",
  "productName": "Mellio",
  "author": "Mellio",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "check": "esbuild scripts/selfcheck.ts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/selfcheck.mjs --log-level=warning && NODE_NO_WARNINGS=1 node .tmp/selfcheck.mjs",
    "demo:react": "esbuild scripts/react-demo.ts --bundle --platform=node --format=esm --outfile=.tmp/react-demo.mjs --log-level=warning && NODE_NO_WARNINGS=1 node .tmp/react-demo.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/funnel-display": "^5.3.0",
    "@fontsource-variable/funnel-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "mathjs": "^15.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.91",
    "@ai-sdk/openai-compatible": "^3.0.96",
    "ai": "^7.0.183",
    "mermaid": "^12.3.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  }
}
